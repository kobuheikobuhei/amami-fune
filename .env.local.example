# 手元で動作確認するための認証情報。
# このファイルをコピーして .env.local という名前で保存し、値を埋めてください。
# .env.local は Git に含まれません（.gitignore で除外済み）。

# Blogger の管理画面URL blogger.com/blog/posts/【この数字】
BLOGGER_BLOG_ID=4367194671988765738

# Google Cloud の「クライアント」で作成した OAuth クライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ここは npm run get-token が自動で書き込みます。手で入力する必要はありません。
GOOGLE_REFRESH_TOKEN=

# User-Agent に入れる情報
SITE_URL=https://amami-fune.blogspot.com/
CONTACT_EMAIL=
